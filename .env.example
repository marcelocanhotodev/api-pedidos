# Copie para .env:  cp .env.example .env
# Valores APENAS para desenvolvimento local. Nunca coloque segredos reais no repositório.

# PostgreSQL (serviço "postgres" do docker-compose)
POSTGRES_DB=pedidos
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos_dev

# Conexão da API com o banco (o host "postgres" é o nome do serviço no Compose)
ConnectionStrings__Padrao=Host=postgres;Port=5432;Database=pedidos;Username=pedidos;Password=pedidos_dev

# Aplica as migrações DbUp ao iniciar (true/false)
APLICAR_MIGRACOES=true

# Segurança (JWT). A chave precisa de no mínimo 32 caracteres; sem ela a API não inicia.
JWT_CHAVE=chave-de-desenvolvimento-troque-em-producao-0123456789
JWT_EMISSOR=pedidos-api
JWT_AUDIENCIA=pedidos-clientes
JWT_EXPIRA_MINUTOS=60

# Usuário único autorizado a emitir tokens em POST /api/v1/auth/token
AUTH_USUARIO=admin
AUTH_SENHA=admin_dev

# Development | Production
ASPNETCORE_ENVIRONMENT=Development
