{
  "uid": "api-pedidos-logs",
  "title": "API de Pedidos — Logs",
  "tags": ["api-pedidos", "logs"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "nivel",
        "label": "Nível",
        "type": "custom",
        "query": "Information,Warning,Error,Fatal",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Volume de logs por nível",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 7 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (nivel) (count_over_time({servico=\"api\", nivel=~\"$nivel\"} [$__auto]))",
          "legendFormat": "{{nivel}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Requisições com erro (5xx)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 8 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{servico=\"api\"} | json | Properties_StatusCode >= 500 | line_format \"{{.Properties_RequestMethod}} {{.Properties_RequestPath}} -> {{.Properties_StatusCode}} ({{.Properties_Elapsed}} ms) traceId={{.TraceId}}\""
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Logs recentes da API",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 14 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "showLabels": false },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{servico=\"api\", nivel=~\"$nivel\"} | json | line_format \"[{{.Level}}] {{.RenderedMessage}}\""
        }
      ]
    }
  ]
}
